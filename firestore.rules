rules_version = '2';

// Security rules for Cuboid Studio "Projects" persistence.
//
// Model:
//   projects/{projectId}                                  — owned doc
//   projects/{projectId}/sites/{siteId}                   — subcollection
//   projects/{projectId}/sites/{siteId}/compositions/{id} — subcollection
//
// Only the authenticated owner (ownerId == request.auth.uid) may read or write
// a project and everything beneath it. Unauthenticated users get nothing.
//
// NOTE: This repo shares the `archthesis` Firebase project, and archthesis's
// deploy workflow ships archthesis/firestore.rules on every merge to its main
// branch, REPLACING the live ruleset. The deployed source of truth is
// therefore archthesis/firestore.rules, which carries a copy of the match
// blocks below alongside archthesis's own rules. This file is the reference
// copy — when editing rules here, mirror the change into
// archthesis/firestore.rules or it will never reach production (and the next
// archthesis deploy would wipe it, locking users out of projects/lexicons).

service cloud.firestore {
  match /databases/{database}/documents {

    // Research service identity (Phase 0 harness + export). Granted via a
    // Firebase Custom Claim (research: true) set through the Admin SDK, the
    // same mechanism archthesis uses for its admin claim:
    //   admin.auth().setCustomUserClaims(uid, { research: true })
    function isResearch() {
      return request.auth != null
        && request.auth.token.research == true;
    }

    // research_records — Phase 0 baseline dataset (append-only).
    // Create-only for the research identity; update/delete denied for
    // EVERYONE (research and admin included): records are never edited or
    // deleted, corrections are new records (phase0-baseline-spec principle 3).
    match /research_records/{recordId} {
      allow read: if isResearch();
      allow create: if isResearch();
      allow update, delete: if false;
    }

    // research_batches — one manifest per batch (corpus source + raw vs used
    // counts, matrix, regime hashes). Same append-only regime.
    match /research_batches/{batchId} {
      allow read: if isResearch();
      allow create: if isResearch();
      allow update, delete: if false;
    }

    // Lexicons — top-level collection, scoped per owner (L3).
    // Only the authenticated owner may read or write their lexicons.
    match /lexicons/{lexiconId} {
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;
      allow read, update, delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;
    }

    // Translation lexicons — editable Pataphysical/Evolution vocabularies.
    // Top-level collection, scoped per owner; same access model as lexicons.
    match /translationLexicons/{lexiconId} {
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;
      allow read, update, delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;
    }

    match /projects/{projectId} {
      // The owner field is set on create and must match the caller.
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;
      allow read, update, delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;

      // Sites + compositions inherit access from the parent project's owner.
      match /sites/{siteId} {
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;

        match /compositions/{compositionId} {
          allow read, write: if request.auth != null
            && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
        }
      }
    }
  }
}
