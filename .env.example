# Cuboid Studio — Environment Variables
# Copy this file to .env.local and fill in your values.

# ---------------------------------------------------------------------------
# API Keys (set one or both in Vercel dashboard)
# ---------------------------------------------------------------------------

# OpenRouter API key — primary LLM gateway (provider-independent)
# Get yours at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Anthropic API key — legacy fallback, used when OPENROUTER_API_KEY is not set
ANTHROPIC_API_KEY=

# Map context app URL for the Map tab iframe (frontend / Vite env).
# Default points to the production Railway deployment.
VITE_MAP_CONTEXT_URL=https://map-context-production.up.railway.app

# ---------------------------------------------------------------------------
# Firebase (Projects & Composition persistence)
# ---------------------------------------------------------------------------
# These point at the SAME Firebase project as the sister repo `archthesis`
# (project id: adaptivememeticarchitect-2776f). Auth is email/password.
# Copy the values from the archthesis .env / Firebase console "Web app" config.
# If these are left blank, the Sign in / Projects UI simply never appears and
# the app behaves exactly as before for everyone.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=adaptivememeticarchitect-2776f.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=adaptivememeticarchitect-2776f
VITE_FIREBASE_STORAGE_BUCKET=adaptivememeticarchitect-2776f.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Feature Flags
# ---------------------------------------------------------------------------

# TRANSLATION_MODEL — model used for meme translation (Pataphysical + Evolve),
# OpenRouter-style id (e.g. anthropic/claude-sonnet-4.6). Leave blank for the
# built-in default. See docs/MODEL_STRATEGY.md for how this gets chosen.
TRANSLATION_MODEL=

# ENCODE_MODEL — vision model used for photo encoding. Anthropic or
# OpenRouter-style id (normalized either way). Blank = built-in default.
ENCODE_MODEL=

# TRANSLATION_PASS_MODE controls the pataphysical translation pipeline behavior.
#
# Values:
#   "single"    — (default) v1 single-pass translation. Returns a flat JSON object
#                  matching LLMOperatorResult. Used by Evolution mode and v1
#                  Pataphysical mode.
#
#   "two_pass"  — v2 two-pass translation. Returns { pass1, pass2, model }.
#                  Pass 1 = cultural operator extraction.
#                  Pass 2 = geometric translation with confidence vector.
#                  Requires pataphysical-translation-v2.md prompt file.
#                  Supports site_context injection.
#
# NOTE: Client functions can override this per-request:
#   - translateMeme()        always uses "single" (Evolution + v1 compat)
#   - translateMemeTwoPass() always uses "two_pass" (v2 Pataphysical mode)
#
# The env var serves as the server-side default and emergency rollback switch.
TRANSLATION_PASS_MODE=single
